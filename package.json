{
  "name": "meetmyzone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:cloudflare",
    "start": "next start",
    "lint": "eslint",
    "dev:local": "MMZ_DISABLE_DIRECTORY_LOCK=1 next dev --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node tests/regressions.cjs",
    "build:cloudflare": "node scripts/prepare-cloudflare.cjs && MMZ_CLOUDFLARE_BUILD=1 MMZ_DISABLE_DIRECTORY_LOCK=1 opennextjs-cloudflare build && node tests/cloudflare-manifests.cjs && node scripts/prepare-static-cloudflare.cjs && node tests/static-cloudflare.cjs",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "og:static": "node scripts/static-og.cjs",
    "build:next": "next build --webpack"
  },
  "dependencies": {
    "@types/luxon": "^3.7.2",
    "@types/three": "^0.185.1",
    "luxon": "^3.7.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
